# Ən azı bir sifariş kanalı doldurulmalıdır. Heç biri yoxdursa, sifariş yalnız
# server loguna yazılır (lokal inkişaf üçün).

# Google Sheets — apps-script/Code.gs-i Web app kimi deploy edin, URL-i bura yazın.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Telegram — @BotFather-dən token; chat id botu qrupa əlavə edib getUpdates ilə tapılır.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# İstəyə bağlı: bankın/PSP-nin ödəniş linki. Boşdursa, operator linki zəng edib göndərir.
PAYMENT_LINK_URL=
