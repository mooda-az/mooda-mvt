# Sertifikanı Caddy Let's Encrypt-dən HTTP-01 ilə alır və yeniləyir.
# Cloudflare proxy açıq olanda SSL rejimi Full (strict) olmalıdır.
mvt.mooda.az {
	encode zstd gzip
	reverse_proxy mvt:3200
}

# www.mvt.mooda.az-ın öz sertifikatı var və hər sorğunu əsas ünvana 301 ilə yönləndirir.
www.mvt.mooda.az {
	redir https://mvt.mooda.az{uri} permanent
}
